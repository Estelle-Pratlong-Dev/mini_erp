{% extends 'app/layout.html.twig' %}

{% block title %}{{ titre }} — mini ERP{% endblock %}
{% block page_title %}{{ titre }}{% endblock %}

{% block main %}
<div class="card shadow-sm">
    <div class="card-body">
        {{ form_start(form) }}
        <div class="row g-3">
            <div class="col-md-4">{{ form_row(form.type) }}</div>
            <div class="col-md-4">
                {{ form_label(form.categorie) }}
                <div class="input-group">
                    {{ form_widget(form.categorie) }}
                    <button type="button" class="btn btn-outline-secondary" id="btn-add-categorie"
                            data-url="{{ path('app_contact_categorie_add') }}"
                            data-token="{{ csrf_token('add_categorie') }}" title="Ajouter une catégorie">
                        <i class="bi bi-plus-lg"></i>
                    </button>
                </div>
                {{ form_errors(form.categorie) }}
            </div>
            <div class="col-md-4">{{ form_row(form.nom) }}</div>
            <div class="col-md-4">{{ form_row(form.prenom) }}</div>
            <div class="col-md-4">{{ form_row(form.siret) }}</div>
            <div class="col-md-4">{{ form_row(form.numTva) }}</div>
            <div class="col-md-6">{{ form_row(form.email) }}</div>
            <div class="col-md-6">{{ form_row(form.telephone) }}</div>
            <div class="col-md-12 position-relative">{{ form_row(form.adresse) }}</div>
            <div class="col-md-3">{{ form_row(form.codePostal) }}</div>
            <div class="col-md-5">{{ form_row(form.ville) }}</div>
            <div class="col-md-4">{{ form_row(form.pays) }}</div>
            <div class="col-12">{{ form_row(form.notes) }}</div>
        </div>
        <div class="mt-3">
            <button class="btn btn-primary">Enregistrer</button>
            <a href="{{ path('app_contact_index') }}" class="btn btn-link">Annuler</a>
        </div>
        {{ form_end(form) }}
    </div>
</div>

<script>
(function () {
    // ----- 1) Grisage des champs selon le type -----
    const typeSel = document.querySelector('.contact-type');
    function setEnabled(el, on) {
        el.disabled = !on;
        const col = el.closest('.col-md-4, .col-md-6, .col-md-12, .col-md-3, .col-md-5');
        if (col) col.style.opacity = on ? '1' : '.5';
    }
    function applyType() {
        const particulier = typeSel.value === 'PARTICULIER';
        document.querySelectorAll('.champ-particulier').forEach((el) => setEnabled(el, particulier));
        document.querySelectorAll('.champ-pro').forEach((el) => setEnabled(el, !particulier));
    }
    if (typeSel) { typeSel.addEventListener('change', applyType); applyType(); }

    // ----- 2) Ajout rapide d'une catégorie -----
    const addBtn = document.getElementById('btn-add-categorie');
    const catSel = document.querySelector('.contact-categorie');
    if (addBtn && catSel) {
        addBtn.addEventListener('click', async function () {
            const nom = (prompt('Nom de la nouvelle catégorie :') || '').trim();
            if (!nom) return;
            const body = new FormData();
            body.append('nom', nom);
            body.append('_token', addBtn.dataset.token);
            try {
                const res = await fetch(addBtn.dataset.url, { method: 'POST', body });
                const data = await res.json();
                if (!res.ok) { alert(data.error || 'Erreur'); return; }
                let opt = Array.from(catSel.options).find((o) => o.value == data.id);
                if (!opt) { opt = new Option(data.nom, data.id); catSel.add(opt); }
                catSel.value = data.id;
            } catch (e) { alert('Erreur réseau'); }
        });
    }

    // ----- 3) Auto-complétion d'adresse (Base Adresse Nationale) -----
    const adr = document.querySelector('.adresse-autocomplete');
    const cp = document.querySelector('.adresse-cp');
    const ville = document.querySelector('.adresse-ville');
    if (adr) {
        const box = document.createElement('ul');
        box.className = 'list-group position-absolute w-100 shadow-sm';
        box.style.zIndex = '1000';
        box.style.display = 'none';
        adr.parentNode.appendChild(box);
        let timer = null;

        function hide() { box.style.display = 'none'; box.innerHTML = ''; }

        adr.addEventListener('input', function () {
            clearTimeout(timer);
            const q = adr.value.trim();
            if (q.length < 3) { hide(); return; }
            timer = setTimeout(async function () {
                try {
                    const res = await fetch('https://api-adresse.data.gouv.fr/search/?limit=5&autocomplete=1&q=' + encodeURIComponent(q));
                    const data = await res.json();
                    box.innerHTML = '';
                    (data.features || []).forEach((f) => {
                        const p = f.properties;
                        const li = document.createElement('li');
                        li.className = 'list-group-item list-group-item-action';
                        li.style.cursor = 'pointer';
                        li.textContent = p.label;
                        li.addEventListener('mousedown', function (e) {
                            e.preventDefault();
                            adr.value = p.name || '';
                            if (cp) cp.value = p.postcode || '';
                            if (ville) ville.value = p.city || '';
                            hide();
                        });
                        box.appendChild(li);
                    });
                    box.style.display = data.features && data.features.length ? 'block' : 'none';
                } catch (e) { hide(); }
            }, 300);
        });
        adr.addEventListener('blur', () => setTimeout(hide, 150));
    }
})();
</script>

<script>
(function () {
    const typeSel = document.querySelector('.contact-type');
    const nom = document.getElementById('contact_nom');
    const siret = document.getElementById('contact_siret');
    const tva = document.getElementById('contact_numTva');
    const adr = document.getElementById('contact_adresse');
    const cp = document.getElementById('contact_codePostal');
    const ville = document.getElementById('contact_ville');
    if (!nom) return;
    const estPro = () => typeSel && typeSel.value !== 'PARTICULIER';

    // ----- Auto-remplissage entreprise (API Recherche d'entreprises) -----
    function tvaFr(siren) {
        const s = parseInt(siren, 10);
        if (isNaN(s)) return '';
        const cle = (12 + 3 * (s % 97)) % 97;
        return 'FR' + String(cle).padStart(2, '0') + siren;
    }
    nom.parentNode.style.position = 'relative';
    const box = document.createElement('ul');
    box.className = 'list-group position-absolute w-100 shadow-sm';
    box.style.zIndex = '1000';
    box.style.display = 'none';
    nom.parentNode.appendChild(box);
    let timer = null;
    const hide = () => { box.style.display = 'none'; box.innerHTML = ''; };

    nom.addEventListener('input', function () {
        clearTimeout(timer);
        if (!estPro()) { hide(); return; }
        const q = nom.value.trim();
        if (q.length < 3) { hide(); return; }
        timer = setTimeout(async function () {
            try {
                const res = await fetch('https://recherche-entreprises.api.gouv.fr/search?per_page=5&q=' + encodeURIComponent(q));
                const data = await res.json();
                box.innerHTML = '';
                (data.results || []).forEach((r) => {
                    const s = r.siege || {};
                    const li = document.createElement('li');
                    li.className = 'list-group-item list-group-item-action';
                    li.style.cursor = 'pointer';
                    li.innerHTML = '<strong>' + (r.nom_complet || '') + '</strong> <small class="text-muted">' + (s.libelle_commune || '') + (s.siret ? ' · ' + s.siret : '') + '</small>';
                    li.addEventListener('mousedown', function (e) {
                        e.preventDefault();
                        nom.value = r.nom_complet || r.nom_raison_sociale || nom.value;
                        if (siret) siret.value = s.siret || '';
                        if (tva && r.siren) tva.value = tvaFr(r.siren);
                        const rue = [s.numero_voie, s.type_voie, s.libelle_voie].filter(Boolean).join(' ');
                        if (adr) adr.value = rue || s.adresse || '';
                        if (cp) cp.value = s.code_postal || '';
                        if (ville) ville.value = s.libelle_commune || '';
                        hide();
                    });
                    box.appendChild(li);
                });
                box.style.display = (data.results && data.results.length) ? 'block' : 'none';
            } catch (e) { hide(); }
        }, 350);
    });
    nom.addEventListener('blur', () => setTimeout(hide, 150));

    // ----- Alerte de doublon à la création (n'empêche pas) -----
    const isNew = {{ form.vars.data.id is null ? 'true' : 'false' }};
    const checkUrl = '{{ path('app_contact_check_duplicate') }}';
    const form = nom.form;
    if (isNew && form) {
        let confirme = false;
        form.addEventListener('submit', async function (e) {
            if (confirme) return; // déjà confirmé
            e.preventDefault();
            const params = new URLSearchParams({
                nom: nom.value || '',
                email: (document.getElementById('contact_email') || {}).value || '',
                siret: siret ? siret.value : '',
            });
            try {
                const res = await fetch(checkUrl + '?' + params.toString());
                const matches = await res.json();
                if (matches.length > 0) {
                    const liste = matches.map((m) => '• ' + m.nom + (m.ville ? ' (' + m.ville + ')' : '')).join('\n');
                    if (!confirm('⚠️ Un contact similaire existe déjà :\n\n' + liste + '\n\nCréer quand même ce contact ?')) {
                        return; // annulé
                    }
                }
            } catch (err) { /* en cas d'erreur réseau, on laisse passer */ }
            confirme = true;
            form.submit();
        });
    }
})();
</script>
{% endblock %}
