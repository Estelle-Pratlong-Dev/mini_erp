{% extends 'app/layout.html.twig' %}

{% block title %}{{ titre }} — mini ERP{% endblock %}
{% block page_title %}{{ titre }}{% endblock %}

{% block main %}
<div class="card shadow-sm">
    <div class="card-body">
        {{ form_start(form) }}
        <div class="row g-3">
            <div class="col-md-6">{{ form_row(form.projet) }}</div>
            <div class="col-md-3">{{ form_row(form.type) }}</div>
            <div class="col-md-3">{{ form_row(form.statut) }}</div>
            <div class="col-md-4">{{ form_row(form.reference) }}</div>
            <div class="col-md-4">{{ form_row(form.dateEmission) }}</div>
            <div class="col-md-4">{{ form_row(form.dateValidite) }}</div>
        </div>

        <h5 class="mt-4">Lignes</h5>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead class="table-light">
                    <tr><th style="width:22%">Produit</th><th>Désignation</th><th style="width:10%">Qté</th><th style="width:12%">PU HT</th><th style="width:10%">TVA %</th><th style="width:5%"></th></tr>
                </thead>
                <tbody id="lignes-body"
                       data-prototype="{{ form_widget(form.lignes.vars.prototype)|e('html_attr') }}"
                       data-index="{{ form.lignes|length }}">
                    {% for ligne in form.lignes %}
                        <tr>
                            <td>{{ form_widget(ligne.produit) }}</td>
                            <td>{{ form_widget(ligne.designation) }}</td>
                            <td>{{ form_widget(ligne.quantite) }}</td>
                            <td>{{ form_widget(ligne.prixUnitaireHt) }}</td>
                            <td>{{ form_widget(ligne.tauxTva) }}</td>
                            <td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger btn-remove-ligne"><i class="bi bi-x-lg"></i></button></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <button type="button" class="btn btn-sm btn-outline-primary" id="btn-add-ligne"><i class="bi bi-plus-lg"></i> Ajouter une ligne</button>

        <div class="mt-3">{{ form_row(form.notes) }}</div>

        <div class="mt-3">
            <button class="btn btn-primary">Enregistrer</button>
            <a href="{{ path('app_contrat_index') }}" class="btn btn-link">Annuler</a>
        </div>
        {{ form_end(form) }}
    </div>
</div>

<script>
(function () {
    const body = document.getElementById('lignes-body');
    const addBtn = document.getElementById('btn-add-ligne');

    function wrapPrototype(html) {
        // Le prototype rend les champs ; on les place dans une ligne de tableau.
        const tpl = document.createElement('template');
        tpl.innerHTML = html.trim();
        const widgets = tpl.content.querySelectorAll('input, select, textarea');
        const tr = document.createElement('tr');
        const cells = ['produit', 'designation', 'quantite', 'prixUnitaireHt', 'tauxTva'];
        cells.forEach(() => tr.appendChild(document.createElement('td')));
        const tdActions = document.createElement('td');
        tdActions.className = 'text-end';
        tdActions.innerHTML = '<button type="button" class="btn btn-sm btn-outline-danger btn-remove-ligne"><i class="bi bi-x-lg"></i></button>';
        tr.appendChild(tdActions);
        // Répartit chaque widget dans sa cellule selon le suffixe de son name.
        widgets.forEach((w) => {
            let idx = cells.findIndex((c) => (w.name || '').endsWith('[' + c + ']'));
            if (idx < 0) idx = 1;
            tr.children[idx].appendChild(w);
        });
        return tr;
    }

    addBtn.addEventListener('click', function () {
        let index = parseInt(body.dataset.index, 10);
        const html = body.dataset.prototype.replace(/__name__/g, index);
        body.appendChild(wrapPrototype(html));
        body.dataset.index = index + 1;
    });

    body.addEventListener('click', function (e) {
        const btn = e.target.closest('.btn-remove-ligne');
        if (btn) {
            btn.closest('tr').remove();
        }
    });
})();
</script>
{% endblock %}
