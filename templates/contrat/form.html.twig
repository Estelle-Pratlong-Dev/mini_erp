{% extends 'app/layout.html.twig' %}

{% set contrat = form.vars.data %}

{% block title %}{{ titre }} — mini ERP{% endblock %}
{% block page_title %}{{ titre }}{% endblock %}

{% block main %}
<div class="card shadow-sm">
    <div class="card-body">
        {{ form_start(form) }}
        {% if contrat.reference %}
            <div class="alert alert-light border d-inline-block py-2">
                <i class="bi bi-hash"></i> Référence <strong>{{ contrat.reference }}</strong>
            </div>
        {% else %}
            <p class="text-muted small"><i class="bi bi-info-circle"></i> La référence sera générée automatiquement à l'enregistrement.</p>
        {% endif %}
        <div class="row g-3">
            <div class="col-md-6">{{ form_row(form.projet) }}</div>
            <div class="col-md-6">{{ form_row(form.contact) }}</div>
            <div class="col-md-3">{{ form_row(form.type) }}</div>
            <div class="col-md-3">{{ form_row(form.statut) }}</div>
            <div class="col-md-3">{{ form_row(form.dateEmission) }}</div>
            <div class="col-md-3">{{ form_row(form.dateValidite) }}</div>
        </div>

        <h5 class="mt-4">Lignes</h5>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead class="table-light">
                    <tr>
                        <th style="width:34%">Article (catalogue)</th>
                        <th style="width:10%">Qté</th>
                        <th style="width:12%">PU HT</th>
                        <th style="width:9%">TVA %</th>
                        <th class="text-end" style="width:11%">Montant HT</th>
                        <th class="text-end" style="width:10%">TVA</th>
                        <th class="text-end" style="width:11%">Montant TTC</th>
                        <th style="width:3%"></th>
                    </tr>
                </thead>
                <tbody id="lignes-body"
                       data-prototype="{{ form_widget(form.lignes.vars.prototype)|e('html_attr') }}"
                       data-index="{{ form.lignes|length }}">
                    {% for ligne in form.lignes %}
                        {% set l = ligne.vars.data %}
                        <tr>
                            <td>{{ form_widget(ligne.produit) }}{{ form_errors(ligne.produit) }}</td>
                            <td>{{ form_widget(ligne.quantite) }}</td>
                            <td>{{ form_widget(ligne.prixUnitaireHt) }}</td>
                            <td>{{ form_widget(ligne.tauxTva) }}</td>
                            <td class="text-end cell-ht">{{ l.montantHt|number_format(2, ',', ' ') }} €</td>
                            <td class="text-end cell-tva">{{ l.montantTva|number_format(2, ',', ' ') }} €</td>
                            <td class="text-end cell-ttc">{{ l.montantTtc|number_format(2, ',', ' ') }} €</td>
                            <td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger btn-remove-ligne"><i class="bi bi-x-lg"></i></button></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <button type="button" class="btn btn-sm btn-outline-primary" id="btn-add-ligne"><i class="bi bi-plus-lg"></i> Ajouter une ligne</button>

        {# ===== Totaux (mis à jour en direct) ===== #}
        <div class="d-flex justify-content-end mt-3">
            <table class="table w-auto mb-0">
                <tr><td class="pe-4">Total HT</td><td class="text-end" id="ct-ht">{{ contrat.totalHt|number_format(2, ',', ' ') }} €</td></tr>
                <tr><td class="pe-4">TVA</td><td class="text-end" id="ct-tva">{{ contrat.totalTva|number_format(2, ',', ' ') }} €</td></tr>
                <tr class="fw-bold border-top"><td class="pe-4">Total TTC</td><td class="text-end" id="ct-ttc">{{ contrat.totalTtc|number_format(2, ',', ' ') }} €</td></tr>
            </table>
        </div>

        <div class="mt-3">{{ form_row(form.notes) }}</div>

        <div class="mt-3">
            <button class="btn btn-primary">Enregistrer</button>
            <a href="{{ path('app_contrat_index') }}" class="btn btn-link">Annuler</a>
        </div>
        {{ form_end(form) }}
    </div>
</div>

<script>
(function () {
    const body = document.getElementById('lignes-body');
    const addBtn = document.getElementById('btn-add-ligne');
    const num = (v) => parseFloat((v || '0').toString().replace(',', '.')) || 0;
    const fmt = (n) => (Math.round(n * 100) / 100).toFixed(2).replace('.', ',') + ' €';
    const setText = (id, txt) => { const el = document.getElementById(id); if (el) el.textContent = txt; };

    function recompute() {
        let tHt = 0, tTva = 0;
        body.querySelectorAll('tr').forEach((row) => {
            const q = num((row.querySelector('[name$="[quantite]"]') || {}).value);
            const pu = num((row.querySelector('[name$="[prixUnitaireHt]"]') || {}).value);
            const t = num((row.querySelector('[name$="[tauxTva]"]') || {}).value);
            const ht = q * pu, tva = ht * t / 100;
            const cHt = row.querySelector('.cell-ht'), cTva = row.querySelector('.cell-tva'), cTtc = row.querySelector('.cell-ttc');
            if (cHt) cHt.textContent = fmt(ht);
            if (cTva) cTva.textContent = fmt(tva);
            if (cTtc) cTtc.textContent = fmt(ht + tva);
            tHt += ht; tTva += tva;
        });
        setText('ct-ht', fmt(tHt));
        setText('ct-tva', fmt(tTva));
        setText('ct-ttc', fmt(tHt + tTva));
    }

    function wrapPrototype(html) {
        const tpl = document.createElement('template');
        tpl.innerHTML = html.trim();
        const widgets = tpl.content.querySelectorAll('input, select, textarea');
        const tr = document.createElement('tr');
        const cells = ['produit', 'quantite', 'prixUnitaireHt', 'tauxTva'];
        cells.forEach(() => tr.appendChild(document.createElement('td')));
        ['cell-ht', 'cell-tva', 'cell-ttc'].forEach((c) => {
            const td = document.createElement('td');
            td.className = 'text-end ' + c;
            tr.appendChild(td);
        });
        const tdActions = document.createElement('td');
        tdActions.className = 'text-end';
        tdActions.innerHTML = '<button type="button" class="btn btn-sm btn-outline-danger btn-remove-ligne"><i class="bi bi-x-lg"></i></button>';
        tr.appendChild(tdActions);
        widgets.forEach((w) => {
            let idx = cells.findIndex((c) => (w.name || '').endsWith('[' + c + ']'));
            if (idx < 0) idx = 0;
            tr.children[idx].appendChild(w);
        });
        return tr;
    }

    addBtn.addEventListener('click', function () {
        let index = parseInt(body.dataset.index, 10);
        body.appendChild(wrapPrototype(body.dataset.prototype.replace(/__name__/g, index)));
        body.dataset.index = index + 1;
        recompute();
    });
    body.addEventListener('click', function (e) {
        const btn = e.target.closest('.btn-remove-ligne');
        if (btn) { btn.closest('tr').remove(); recompute(); }
    });
    document.addEventListener('input', recompute);

    // Pré-remplit le client avec celui du projet sélectionné (si le client est vide).
    const projetSel = document.querySelector('.contrat-projet');
    const contactSel = document.querySelector('.contrat-contact');
    if (projetSel && contactSel) {
        projetSel.addEventListener('change', function () {
            const opt = projetSel.selectedOptions[0];
            const cid = opt ? opt.dataset.contact : '';
            if (cid && !contactSel.value) { contactSel.value = cid; }
        });
    }

    recompute();
})();
</script>
{% endblock %}
