{% extends 'app/layout.html.twig' %}

{% block title %}Devis / Contrats — mini ERP{% endblock %}
{% block page_title %}Devis / Contrats{% endblock %}
{% block page_actions %}
    {% if is_granted('ROLE_CONTRATS_CREER') %}
        <a href="{{ path('app_contrat_new') }}" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Nouveau</a>
    {% endif %}
{% endblock %}

{% block main %}
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Type</th><th>Réf.</th><th>Projet</th><th>Date</th><th>Statut</th><th class="text-end">Total TTC</th><th class="text-end">Actions</th></tr>
            </thead>
            <tbody>
            {% for contrat in contrats %}
                <tr>
                    <td>{{ contrat.type.libelle }}</td>
                    <td><a href="{{ path('app_contrat_show', {id: contrat.id}) }}">{{ contrat.reference ?: '#' ~ contrat.id }}</a></td>
                    <td>{{ contrat.projet.nom }}</td>
                    <td>{{ contrat.dateEmission|date('d/m/Y') }}</td>
                    <td><span class="badge text-bg-{{ contrat.statut.couleur }}">{{ contrat.statut.libelle }}</span></td>
                    <td class="text-end">{{ contrat.totalTtc|number_format(2, ',', ' ') }} €</td>
                    <td class="text-end">
                        <a href="{{ path('app_contrat_show', {id: contrat.id}) }}" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a>
                        {% if is_granted('ROLE_CONTRATS_MODIFIER') %}
                            <a href="{{ path('app_contrat_edit', {id: contrat.id}) }}" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="7" class="text-center text-muted py-4">Aucun document.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
