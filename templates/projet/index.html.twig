{% extends 'app/layout.html.twig' %}

{% block title %}Projets — mini ERP{% endblock %}
{% block page_title %}Projets{% endblock %}
{% block page_actions %}
    {% if is_granted('ROLE_PROJETS_CREER') %}
        <a href="{{ path('app_projet_new') }}" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Nouveau projet</a>
    {% endif %}
{% endblock %}

{% block main %}
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Date</th><th>Nom</th><th>Client</th><th>Statut</th><th class="text-end">Contrats</th><th class="text-end">Actions</th></tr>
            </thead>
            <tbody>
            {% for projet in projets %}
                <tr>
                    <td>{{ projet.date ? projet.date|date('d/m/Y') : '' }}</td>
                    <td><a href="{{ path('app_projet_show', {id: projet.id}) }}">{{ projet.nom }}</a></td>
                    <td>{{ projet.contact }}</td>
                    <td><span class="badge text-bg-{{ projet.statut.couleur }}">{{ projet.statut.libelle }}</span></td>
                    <td class="text-end">{{ projet.contrats|length }}</td>
                    <td class="text-end">
                        <a href="{{ path('app_projet_show', {id: projet.id}) }}" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a>
                        {% if is_granted('ROLE_PROJETS_MODIFIER') %}
                            <a href="{{ path('app_projet_edit', {id: projet.id}) }}" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="6" class="text-center text-muted py-4">Aucun projet.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
