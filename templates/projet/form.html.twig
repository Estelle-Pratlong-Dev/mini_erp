{% extends 'app/layout.html.twig' %}

{% block title %}{{ titre }} — mini ERP{% endblock %}
{% block page_title %}{{ titre }}{% endblock %}

{% block main %}
<div class="card shadow-sm">
    <div class="card-body">
        {{ form_start(form) }}
        <div class="row g-3">
            <div class="col-md-6">{{ form_row(form.nom) }}</div>
            <div class="col-md-6">{{ form_row(form.contact) }}</div>
            <div class="col-md-4">{{ form_row(form.date) }}</div>
            <div class="col-md-4">{{ form_row(form.statut) }}</div>
            <div class="col-12">{{ form_row(form.description) }}</div>
        </div>
        <div class="mt-3">
            <button class="btn btn-primary">Enregistrer</button>
            <a href="{{ path('app_projet_index') }}" class="btn btn-link">Annuler</a>
        </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
