{% extends 'app/layout.html.twig' %}

{% block title %}{{ titre }} — mini ERP{% endblock %}
{% block page_title %}{{ titre }}{% endblock %}

{% block main %}
<div class="card shadow-sm">
    <div class="card-body">
        {{ form_start(form) }}
        <div class="row g-3">
            <div class="col-md-4">{{ form_row(form.reference) }}</div>
            <div class="col-md-5">{{ form_row(form.designation) }}</div>
            <div class="col-md-3">{{ form_row(form.type) }}</div>
            <div class="col-12">{{ form_row(form.description) }}</div>
            <div class="col-md-3">{{ form_row(form.prixAchatHt) }}</div>
            <div class="col-md-3">{{ form_row(form.prixHt) }}</div>
            <div class="col-md-3">{{ form_row(form.tauxTva) }}</div>
            <div class="col-md-3">{{ form_row(form.unite) }}</div>
            <div class="col-md-3 d-flex align-items-end">{{ form_row(form.actif) }}</div>
            <div class="col-md-3 d-flex align-items-end">{{ form_row(form.gereStock) }}</div>
            <div class="col-md-3">{{ form_row(form.stockActuel) }}</div>
            <div class="col-md-3">{{ form_row(form.stockMin) }}</div>
        </div>

        <div class="mt-4">
            <span class="form-label d-block">Nature du produit</span>
            <div class="btn-group" role="group" aria-label="Nature du produit">
                <input type="radio" class="btn-check" name="nature_produit" id="nature-simple" value="simple" autocomplete="off">
                <label class="btn btn-outline-primary" for="nature-simple"><i class="bi bi-box"></i> Produit simple</label>
                <input type="radio" class="btn-check" name="nature_produit" id="nature-compose" value="compose" autocomplete="off">
                <label class="btn btn-outline-primary" for="nature-compose"><i class="bi bi-boxes"></i> Produit composé</label>
            </div>
        </div>

        <div id="composition-section">
        <h5 class="mt-4">Composition <small class="text-muted">(articles qui composent le produit)</small></h5>
        <p class="text-muted small">Le stock consommé et le prix d'achat seront calculés depuis ces composants.</p>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead class="table-light">
                    <tr><th style="width:60%">Article composant</th><th style="width:25%">Quantité</th><th style="width:5%"></th></tr>
                </thead>
                <tbody id="composants-body"
                       data-prototype="{{ form_widget(form.composants.vars.prototype)|e('html_attr') }}"
                       data-index="{{ form.composants|length }}">
                    {% for c in form.composants %}
                        <tr>
                            <td>{{ form_widget(c.composant) }}{{ form_errors(c.composant) }}</td>
                            <td>{{ form_widget(c.quantite) }}</td>
                            <td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger btn-remove-c"><i class="bi bi-x-lg"></i></button></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <button type="button" class="btn btn-sm btn-outline-primary" id="btn-add-c"><i class="bi bi-plus-lg"></i> Ajouter un composant</button>
        </div>

        <div class="mt-3">
            <button class="btn btn-primary">Enregistrer</button>
            <a href="{{ path('app_produit_index') }}" class="btn btn-link">Annuler</a>
        </div>
        {{ form_end(form) }}

        <script>
        (function () {
            const body = document.getElementById('composants-body');
            const addBtn = document.getElementById('btn-add-c');
            const prixAchat = document.querySelector('.prix-achat');
            if (!body || !addBtn) return;

            // Recalcule le prix d'achat d'un produit composé = somme(prix achat composant × qté).
            function recompute() {
                if (!prixAchat) return;
                const rows = body.querySelectorAll('tr');
                if (rows.length === 0) { prixAchat.disabled = false; return; }
                let total = 0;
                rows.forEach((r) => {
                    const sel = r.querySelector('.composant-article');
                    const qte = r.querySelector('.composant-qte');
                    if (!sel || !qte) return;
                    const opt = sel.selectedOptions[0];
                    const pa = opt ? parseFloat(opt.dataset.prixAchat) : NaN;
                    const q = parseFloat((qte.value || '0').replace(',', '.'));
                    if (!isNaN(pa) && !isNaN(q)) total += pa * q;
                });
                prixAchat.value = (Math.round(total * 100) / 100).toFixed(2);
                prixAchat.disabled = true;
            }

            function wrap(html) {
                const tpl = document.createElement('template');
                tpl.innerHTML = html.trim();
                const widgets = tpl.content.querySelectorAll('input, select, textarea');
                const tr = document.createElement('tr');
                ['composant', 'quantite'].forEach(() => tr.appendChild(document.createElement('td')));
                const td = document.createElement('td');
                td.className = 'text-end';
                td.innerHTML = '<button type="button" class="btn btn-sm btn-outline-danger btn-remove-c"><i class="bi bi-x-lg"></i></button>';
                tr.appendChild(td);
                widgets.forEach((w) => {
                    const idx = (w.name || '').endsWith('[quantite]') ? 1 : 0;
                    tr.children[idx].appendChild(w);
                });
                return tr;
            }
            addBtn.addEventListener('click', function () {
                let i = parseInt(body.dataset.index, 10);
                body.appendChild(wrap(body.dataset.prototype.replace(/__name__/g, i)));
                body.dataset.index = i + 1;
                recompute();
            });
            body.addEventListener('click', function (e) {
                const b = e.target.closest('.btn-remove-c');
                if (b) { b.closest('tr').remove(); recompute(); }
            });
            body.addEventListener('input', recompute);
            body.addEventListener('change', recompute);

            // ----- Sélecteur Simple / Composé -----
            const section = document.getElementById('composition-section');
            const rSimple = document.getElementById('nature-simple');
            const rCompose = document.getElementById('nature-compose');

            function applyNature() {
                const compose = rCompose.checked;
                if (section) section.style.display = compose ? '' : 'none';
                if (compose) {
                    if (body.querySelectorAll('tr').length === 0) addBtn.click();
                    recompute();
                } else {
                    body.innerHTML = '';            // pas de composants pour un produit simple
                    if (prixAchat) prixAchat.disabled = false;
                }
            }

            rSimple.addEventListener('change', applyNature);
            rCompose.addEventListener('change', function () {
                applyNature();
            });
            // Avant de repasser en "simple", on prévient si une composition existe.
            rSimple.addEventListener('click', function (e) {
                if (body.querySelectorAll('tr').length > 0 &&
                    !confirm('Repasser en produit simple supprimera la composition. Continuer ?')) {
                    e.preventDefault();
                    rCompose.checked = true;
                }
            });

            // État initial : composé si des composants existent déjà.
            if (body.querySelectorAll('tr').length > 0) { rCompose.checked = true; } else { rSimple.checked = true; }
            applyNature();
        })();
        </script>
    </div>
</div>
{% endblock %}
