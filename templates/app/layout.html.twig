{% extends 'base.html.twig' %}

{% block body %}
<div class="d-flex">
    {# ===== Barre latérale ===== #}
    <nav class="app-sidebar d-flex flex-column flex-shrink-0 p-3 text-white" style="min-height: 100vh;">
        <a href="{{ path('app_home') }}" class="d-flex align-items-center mb-3 text-white text-decoration-none">
            <span class="fs-5 brand">📊 mini ERP</span>
        </a>
        <hr>
        <ul class="nav nav-pills flex-column mb-auto">
            <li class="nav-item">
                <a href="{{ path('app_home') }}" class="nav-link text-white {{ app.request.attributes.get('_route') == 'app_home' ? 'active' : '' }}">
                    <i class="bi bi-speedometer2 me-2"></i>Tableau de bord
                </a>
            </li>

            {% if module_actif('CONTACTS') %}
            <li>
                <a href="{{ path('app_contact_index') }}" class="nav-link text-white {{ app.request.attributes.get('_route') starts with 'app_contact' ? 'active' : '' }}">
                    <i class="bi bi-people me-2"></i>Contacts
                </a>
            </li>
            {% endif %}

            {% if module_actif('CATALOGUE') %}
            <li>
                <a href="{{ path('app_produit_index') }}" class="nav-link text-white {{ app.request.attributes.get('_route') starts with 'app_produit' ? 'active' : '' }}">
                    <i class="bi bi-box-seam me-2"></i>Catalogue
                </a>
            </li>
            {% endif %}

            {% if module_actif('PROJETS') %}
            <li>
                <a href="{{ path('app_projet_index') }}" class="nav-link text-white {{ app.request.attributes.get('_route') starts with 'app_projet' ? 'active' : '' }}">
                    <i class="bi bi-folder me-2"></i>Projets
                </a>
            </li>
            {% endif %}

            {% if module_actif('CONTRATS') %}
            <li>
                <a href="{{ path('app_contrat_index') }}" class="nav-link text-white {{ app.request.attributes.get('_route') starts with 'app_contrat' ? 'active' : '' }}">
                    <i class="bi bi-file-earmark-text me-2"></i>Devis / Contrats
                </a>
            </li>
            {% endif %}

            {% if module_actif('FACTURATION') %}
            <li>
                <a href="{{ path('app_facture_index') }}" class="nav-link text-white {{ app.request.attributes.get('_route') starts with 'app_facture' ? 'active' : '' }}">
                    <i class="bi bi-receipt me-2"></i>Factures
                </a>
            </li>
            {% endif %}
        </ul>
        <hr>
        <div class="dropdown">
            <a href="#" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle" data-bs-toggle="dropdown">
                <i class="bi bi-person-circle me-2"></i>
                <span class="small">{{ app.user ? app.user.userIdentifier : '' }}</span>
            </a>
            <ul class="dropdown-menu dropdown-menu-dark text-small shadow">
                {% if is_granted('ROLE_ADMIN') %}
                    <li><a class="dropdown-item" href="{{ path('admin') }}"><i class="bi bi-gear me-2"></i>Administration</a></li>
                    <li><hr class="dropdown-divider"></li>
                {% endif %}
                <li><a class="dropdown-item" href="{{ path('app_logout') }}"><i class="bi bi-box-arrow-right me-2"></i>Déconnexion</a></li>
            </ul>
        </div>
    </nav>

    {# ===== Contenu ===== #}
    <main class="flex-grow-1 p-4">
        <div class="app-content">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3 mb-0">{% block page_title %}{% endblock %}</h1>
                <div>{% block page_actions %}{% endblock %}</div>
            </div>

            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show">
                        {{ message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endfor %}
            {% endfor %}

            {% block main %}{% endblock %}
        </div>
    </main>
</div>
{% endblock %}
