{% extends 'app/layout.html.twig' %}

{% set facture = form.vars.data %}
{% set partiel = facture.contrat is not null %}
{% set modifiable = lignesModifiables ?? true %}

{% block title %}{{ titre }} — mini ERP{% endblock %}
{% block page_title %}{{ titre }}{% endblock %}

{% block main %}
<div class="card shadow-sm">
    <div class="card-body">
        {{ form_start(form) }}
        {% if rangContrat is defined and rangContrat %}
            <div class="alert alert-light border d-inline-block py-2">
                <i class="bi bi-info-circle"></i> Facture <strong>{{ rangContrat }}</strong> sur <strong>{{ nbContrat }}</strong> de ce contrat
                {% if rangContrat == 1 %}(première facture){% endif %}
            </div>
        {% endif %}
        <div class="row g-3">
            <div class="col-md-4">{{ form_row(form.projet) }}</div>
            <div class="col-md-4">{{ form_row(form.contact) }}</div>
            <div class="col-md-4">{{ form_row(form.statut) }}</div>
            <div class="col-md-3">{{ form_row(form.dateEmission) }}</div>
            <div class="col-md-3">{{ form_row(form.delaiPaiement) }}</div>
            <div class="col-md-3">{{ form_row(form.dateEcheance) }}</div>
            <div class="col-md-3">{{ form_row(form.modePaiement) }}</div>
        </div>

        <script>
        (function () {
            const emission = document.getElementById('facture_dateEmission');
            const delai = document.getElementById('facture_delaiPaiement');
            const echeance = document.getElementById('facture_dateEcheance');
            function recalc() {
                if (!emission || !delai || !echeance || !emission.value || !delai.value) return;
                const opt = delai.selectedOptions[0];
                if (!opt || opt.dataset.jours === undefined) return;
                const j = parseInt(opt.dataset.jours, 10);
                if (isNaN(j)) return;
                const d = new Date(emission.value);
                d.setDate(d.getDate() + j);
                echeance.value = d.toISOString().slice(0, 10);
            }
            if (delai) delai.addEventListener('change', recalc);
            if (emission) emission.addEventListener('change', recalc);
        })();
        </script>

        <h5 class="mt-4">Lignes</h5>

        {% if partiel and not modifiable %}
        {# ===== Facture verrouillée : une facture plus récente existe ===== #}
        <div class="alert alert-warning"><i class="bi bi-lock"></i> Les lignes sont verrouillées : une facture plus récente existe pour ce contrat. Seule la dernière facture est modifiable.</div>
        <div class="table-responsive">
            <table class="table mb-0">
                <thead class="table-light"><tr><th>Désignation</th><th class="text-end">Qté facturée</th><th class="text-end">PU HT</th><th class="text-end">TVA</th><th class="text-end">Montant HT</th></tr></thead>
                <tbody>
                {% for ligne in facture.lignes %}
                    <tr>
                        <td>{{ ligne.designation }}</td>
                        <td class="text-end">{{ ligne.quantite }}</td>
                        <td class="text-end">{{ ligne.prixUnitaireHt|number_format(2, ',', ' ') }} €</td>
                        <td class="text-end">{{ ligne.tauxTva }} %</td>
                        <td class="text-end">{{ ligne.montantHt|number_format(2, ',', ' ') }} €</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        {% elseif partiel %}
        {# ===== Facture issue d'un contrat : facturation partielle, PU figé ===== #}
        <p class="text-muted small">Modifiez la quantité, le montant <em>ou</em> le % à facturer : les autres se recalculent.</p>
        <div class="row g-2 align-items-end mb-2">
            <div class="col-auto">
                <label class="form-label mb-0" for="global-pct">Facturer un % global sur toutes les lignes</label>
                <div class="input-group" style="max-width: 220px;">
                    <input type="number" step="0.01" min="0" id="global-pct" class="form-control text-end" placeholder="ex. 30">
                    <span class="input-group-text">%</span>
                    <button type="button" class="btn btn-outline-primary" id="apply-global-pct">Appliquer</button>
                </div>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Article</th>
                        <th class="text-end">Qté contrat</th>
                        <th class="text-end">PU HT</th>
                        <th class="text-end">Montant contrat</th>
                        <th class="text-end" style="width:12%">Qté facturée</th>
                        <th class="text-end" style="width:14%">Montant facturé</th>
                        <th class="text-end" style="width:10%">% facturé</th>
                    </tr>
                </thead>
                <tbody>
                {% for ligneForm in form.lignes %}
                    {% set ligne = ligneForm.vars.data %}
                    {% set pu = ligne.prixUnitaireHt %}
                    {% set qc = ligne.quantiteContrat ?: 0 %}
                    {% set mc = ligne.montantContrat ?: 0 %}
                    <tr class="ligne-partielle" data-pu="{{ pu }}" data-qc="{{ qc }}" data-mc="{{ mc }}">
                        <td>
                            {{ ligne.designation }}
                            <div class="d-none">
                                {{ form_widget(ligneForm.produit) }}
                                {{ form_widget(ligneForm.prixUnitaireHt) }}
                                {{ form_widget(ligneForm.tauxTva) }}
                            </div>
                        </td>
                        <td class="text-end text-muted">{{ qc }}</td>
                        <td class="text-end text-muted">{{ pu|number_format(2, ',', ' ') }} €</td>
                        <td class="text-end text-muted">{{ mc|number_format(2, ',', ' ') }} €</td>
                        <td>{{ form_widget(ligneForm.quantite, {attr: {class: 'form-control text-end inp-qte'}}) }}</td>
                        <td><input type="text" class="form-control text-end inp-montant" value="{{ (ligne.quantite * pu)|number_format(2, '.', '') }}"></td>
                        <td><input type="text" class="form-control text-end inp-pct" value="{{ ligne.pourcentageFacture }}"></td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <script>
        (function () {
            document.querySelectorAll('tr.ligne-partielle').forEach(function (row) {
                const pu = parseFloat(row.dataset.pu) || 0;
                const qc = parseFloat(row.dataset.qc) || 0;
                const qte = row.querySelector('.inp-qte');
                const montant = row.querySelector('.inp-montant');
                const pct = row.querySelector('.inp-pct');

                function fmt(n) { return (Math.round(n * 100) / 100); }

                qte.addEventListener('input', function () {
                    const q = parseFloat(qte.value.replace(',', '.')) || 0;
                    montant.value = fmt(q * pu);
                    pct.value = qc ? fmt(q / qc * 100) : '';
                });
                montant.addEventListener('input', function () {
                    const m = parseFloat(montant.value.replace(',', '.')) || 0;
                    const q = pu ? m / pu : 0;
                    qte.value = Math.round(q * 1000) / 1000;
                    pct.value = qc ? fmt(q / qc * 100) : '';
                });
                pct.addEventListener('input', function () {
                    const p = parseFloat(pct.value.replace(',', '.')) || 0;
                    const q = qc * p / 100;
                    qte.value = Math.round(q * 1000) / 1000;
                    montant.value = fmt(q * pu);
                });
            });

            const applyBtn = document.getElementById('apply-global-pct');
            if (applyBtn) {
                applyBtn.addEventListener('click', function () {
                    const val = document.getElementById('global-pct').value;
                    document.querySelectorAll('tr.ligne-partielle .inp-pct').forEach(function (pct) {
                        pct.value = val;
                        pct.dispatchEvent(new Event('input'));
                    });
                });
            }
        })();
        </script>

        {% else %}
        {# ===== Facture directe : saisie libre des lignes ===== #}
        <div class="table-responsive">
            <table class="table align-middle">
                <thead class="table-light">
                    <tr><th style="width:45%">Article (catalogue)</th><th style="width:13%">Qté</th><th style="width:15%">PU HT</th><th style="width:12%">TVA %</th><th style="width:5%"></th></tr>
                </thead>
                <tbody id="lignes-body"
                       data-prototype="{{ form_widget(form.lignes.vars.prototype)|e('html_attr') }}"
                       data-index="{{ form.lignes|length }}">
                    {% for ligneForm in form.lignes %}
                        <tr>
                            <td>{{ form_widget(ligneForm.produit) }}{{ form_errors(ligneForm.produit) }}</td>
                            <td>{{ form_widget(ligneForm.quantite) }}</td>
                            <td>{{ form_widget(ligneForm.prixUnitaireHt) }}</td>
                            <td>{{ form_widget(ligneForm.tauxTva) }}</td>
                            <td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger btn-remove-ligne"><i class="bi bi-x-lg"></i></button></td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        <button type="button" class="btn btn-sm btn-outline-primary" id="btn-add-ligne"><i class="bi bi-plus-lg"></i> Ajouter une ligne</button>

        <script>
        (function () {
            const body = document.getElementById('lignes-body');
            const addBtn = document.getElementById('btn-add-ligne');
            function wrapPrototype(html) {
                const tpl = document.createElement('template');
                tpl.innerHTML = html.trim();
                const widgets = tpl.content.querySelectorAll('input, select, textarea');
                const tr = document.createElement('tr');
                const cells = ['produit', 'quantite', 'prixUnitaireHt', 'tauxTva'];
                cells.forEach(() => tr.appendChild(document.createElement('td')));
                const td = document.createElement('td');
                td.className = 'text-end';
                td.innerHTML = '<button type="button" class="btn btn-sm btn-outline-danger btn-remove-ligne"><i class="bi bi-x-lg"></i></button>';
                tr.appendChild(td);
                widgets.forEach((w) => {
                    let idx = cells.findIndex((c) => (w.name || '').endsWith('[' + c + ']'));
                    if (idx < 0) idx = 0;
                    tr.children[idx].appendChild(w);
                });
                return tr;
            }
            addBtn.addEventListener('click', function () {
                let index = parseInt(body.dataset.index, 10);
                body.appendChild(wrapPrototype(body.dataset.prototype.replace(/__name__/g, index)));
                body.dataset.index = index + 1;
            });
            body.addEventListener('click', function (e) {
                const btn = e.target.closest('.btn-remove-ligne');
                if (btn) { btn.closest('tr').remove(); }
            });
        })();
        </script>
        {% endif %}

        {# ===== Totaux (mis à jour en direct pendant l'édition) ===== #}
        <div class="d-flex justify-content-end mt-3">
            <table class="table w-auto mb-0" id="totaux-facture"
                   data-deja-ht="{{ facture.montantDejaFactureHt ?? 0 }}"
                   data-deja-tva="{{ facture.montantDejaFactureTva ?? 0 }}"
                   data-deduction="{{ facture.aDeduction ? 1 : 0 }}">
                {% if facture.aDeduction %}
                    <tr><td class="text-muted pe-4">Total HT (cumulé)</td><td class="text-end" id="t-ht">{{ facture.totalHt|number_format(2, ',', ' ') }} €</td></tr>
                    <tr class="text-danger"><td class="pe-4">Avancement précédent</td><td class="text-end">− {{ facture.montantDejaFactureHt|number_format(2, ',', ' ') }} €</td></tr>
                    <tr><td class="pe-4">Net HT à payer</td><td class="text-end" id="t-netht">{{ facture.netHt|number_format(2, ',', ' ') }} €</td></tr>
                    <tr><td class="pe-4">TVA</td><td class="text-end" id="t-tva">{{ facture.netTva|number_format(2, ',', ' ') }} €</td></tr>
                    <tr class="fw-bold border-top"><td class="pe-4">Net TTC à payer</td><td class="text-end" id="t-ttc">{{ facture.netTtc|number_format(2, ',', ' ') }} €</td></tr>
                {% else %}
                    <tr><td class="pe-4">Total HT</td><td class="text-end" id="t-ht">{{ facture.totalHt|number_format(2, ',', ' ') }} €</td></tr>
                    <tr><td class="pe-4">TVA</td><td class="text-end" id="t-tva">{{ facture.totalTva|number_format(2, ',', ' ') }} €</td></tr>
                    <tr class="fw-bold border-top"><td class="pe-4">Total TTC</td><td class="text-end" id="t-ttc">{{ facture.totalTtc|number_format(2, ',', ' ') }} €</td></tr>
                {% endif %}
            </table>
        </div>

        <script>
        (function () {
            const box = document.getElementById('totaux-facture');
            if (!box) return;
            const dejaHt = parseFloat(box.dataset.dejaHt) || 0;
            const dejaTva = parseFloat(box.dataset.dejaTva) || 0;
            const deduction = box.dataset.deduction === '1';
            const num = (v) => parseFloat((v || '0').toString().replace(',', '.')) || 0;
            const fmt = (n) => (Math.round(n * 100) / 100).toFixed(2).replace('.', ',') + ' €';

            function recompute() {
                let ht = 0, tva = 0, found = false;
                document.querySelectorAll('tr.ligne-partielle').forEach((row) => {
                    found = true;
                    const pu = parseFloat(row.dataset.pu) || 0;
                    const q = num((row.querySelector('.inp-qte') || {}).value);
                    const t = num((row.querySelector('[name$="[tauxTva]"]') || {}).value);
                    const m = q * pu; ht += m; tva += m * t / 100;
                });
                const body = document.getElementById('lignes-body');
                if (body) {
                    body.querySelectorAll('tr').forEach((row) => {
                        found = true;
                        const q = num((row.querySelector('[name$="[quantite]"]') || {}).value);
                        const pu = num((row.querySelector('[name$="[prixUnitaireHt]"]') || {}).value);
                        const t = num((row.querySelector('[name$="[tauxTva]"]') || {}).value);
                        const m = q * pu; ht += m; tva += m * t / 100;
                    });
                }
                if (!found) return; // lignes verrouillées : on garde les valeurs serveur
                const netHt = ht - dejaHt, netTva = tva - dejaTva;
                const elHt = document.getElementById('t-ht');
                const elNetHt = document.getElementById('t-netht');
                const elTva = document.getElementById('t-tva');
                const elTtc = document.getElementById('t-ttc');
                if (elHt) elHt.textContent = fmt(ht);
                if (deduction) {
                    if (elNetHt) elNetHt.textContent = fmt(netHt);
                    if (elTva) elTva.textContent = fmt(netTva);
                    if (elTtc) elTtc.textContent = fmt(netHt + netTva);
                } else {
                    if (elTva) elTva.textContent = fmt(tva);
                    if (elTtc) elTtc.textContent = fmt(ht + tva);
                }
            }

            document.addEventListener('input', recompute);
            recompute();
        })();
        </script>

        <div class="mt-3">{{ form_row(form.notes) }}</div>

        <div class="mt-3">
            <button class="btn btn-primary">Enregistrer</button>
            <a href="{{ path('app_facture_index') }}" class="btn btn-link">Annuler</a>
        </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
