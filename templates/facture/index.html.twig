{% extends 'app/layout.html.twig' %}

{% block title %}Factures — mini ERP{% endblock %}
{% block page_title %}Factures{% endblock %}
{% block page_actions %}
    {% if is_granted('ROLE_FACTURATION_CREER') %}
        <a href="{{ path('app_facture_new') }}" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Nouvelle facture</a>
    {% endif %}
{% endblock %}

{% block main %}
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Numéro</th><th>Type</th><th>Client</th><th>Projet</th><th>Date</th><th>Statut</th><th class="text-end">Total TTC</th><th class="text-end">Actions</th></tr>
            </thead>
            <tbody>
            {% for facture in factures %}
                <tr>
                    <td><a href="{{ path('app_facture_show', {id: facture.id}) }}">{{ facture.numero }}</a></td>
                    <td>{{ facture.libelleType }}</td>
                    <td>{{ facture.contact ?: 'Comptant' }}</td>
                    <td>{{ facture.projet.nom }}</td>
                    <td>{{ facture.dateEmission|date('d/m/Y') }}</td>
                    <td><span class="badge text-bg-{{ facture.statut.couleur }}">{{ facture.statut.libelle }}</span></td>
                    <td class="text-end">{{ facture.totalTtc|number_format(2, ',', ' ') }} €</td>
                    <td class="text-end">
                        <a href="{{ path('app_facture_pdf', {id: facture.id}) }}" class="btn btn-sm btn-outline-secondary" title="PDF" target="_blank"><i class="bi bi-file-earmark-pdf"></i></a>
                        <a href="{{ path('app_facture_show', {id: facture.id}) }}" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a>
                        {% if is_granted('ROLE_FACTURATION_MODIFIER') %}
                            <a href="{{ path('app_facture_edit', {id: facture.id}) }}" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="8" class="text-center text-muted py-4">Aucune facture.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
